# Datasets are downloaded, never committed - see 00_setup/download_datasets.py
data/
!data/.gitkeep

# Figures ARE committed - they live in each example's images/ folder and are
# embedded in that folder's README, so the repository is readable on GitHub
# without running anything. Regenerate them by re-running the script.

